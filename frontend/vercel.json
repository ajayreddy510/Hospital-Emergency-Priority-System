{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hospital-emergency-backend.onrender.com/api/:path*"
    },
    {
      "source": "/ws-hospital/:path*",
      "destination": "https://hospital-emergency-backend.onrender.com/ws-hospital/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
